# data (too large for git; reproduced via download script)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# results are regenerated (full/ = real run, smoke/ = throwaway smoke-test output)
results/full/*
results/smoke/*
!results/full/.gitkeep
!results/smoke/.gitkeep

# python / jupyter
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
env/

# celltypist model cache
*.pkl

# run logs
*.log

# MS Office lock/temp files (e.g. ~$GI_nanoplastic.pptx while the deck is open)
~$*

# old notebook-based pipeline, kept locally as reference only (not a repo deliverable)
legacy/
